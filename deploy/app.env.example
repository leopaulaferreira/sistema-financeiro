# Copie para /etc/sistema-financeiro/app.env (permissão 0600, dono
# sistema-financeiro:sistema-financeiro) e preencha com valores reais.
# NUNCA commitar o arquivo real — este é só um exemplo, sem segredos.
# Referenciado por deploy/systemd/sistema-financeiro.service (EnvironmentFile).

# --- Banco de dados (banco/role exclusivos desta aplicação — ver DEPLOYMENT.md) ---
DB_URL=jdbc:postgresql://127.0.0.1:5432/sistema_financeiro
DB_USERNAME=sistema_financeiro_app
DB_PASSWORD=troque-esta-senha
DB_POOL_SIZE=4

# --- JWT ---
# Gere com: openssl rand -base64 48
JWT_SECRET=
JWT_ACCESS_EXPIRATION_MINUTES=15
JWT_REFRESH_EXPIRATION_DAYS=30

# --- Cookies ---
# true em produção (HTTPS obrigatório atrás do Nginx) — não mudar para
# false em produção, o navegador descartaria os cookies de auth.
COOKIE_SECURE=true

# --- CORS ---
# Same-origin via Nginx (frontend chama /api na mesma origem) — normalmente
# nem precisa de CORS de verdade, mas o backend exige um valor configurado.
# Usar o domínio público real (ex.: https://financas.seudominio.com).
CORS_ALLOWED_ORIGIN=https://SEU-DOMINIO-AQUI

# --- Servidor ---
# Escolher só depois de checar portas já em uso na VM real (ver
# DEPLOYMENT.md) — este valor é um exemplo, não uma porta reservada.
SERVER_PORT=8084

# --- Rate limiting de auth (Fase 9/10) ---
# Defaults já conservadores (application.yml) — normalmente não precisa
# sobrescrever. Descomente só se precisar ajustar em produção.
# APP_AUTH_RATE-LIMIT_MAX-ATTEMPTS=10
# APP_AUTH_RATE-LIMIT_WINDOW-SECONDS=60

# --- Scheduler de recorrências (Fase 6) ---
# RECURRING_PROCESSING_CRON=0 0 * * * *

# --- Logging (opcional, só para diagnóstico pontual) ---
# LOGGING_LEVEL_ROOT=INFO
# LOGGING_LEVEL_APP=DEBUG
# LOGGING_LEVEL_SECURITY=DEBUG
# LOGGING_LEVEL_HIBERNATE_SQL=DEBUG

# --- Perfil ativo ---
# Já fixado como "prod" no próprio .service — não precisa repetir aqui.
