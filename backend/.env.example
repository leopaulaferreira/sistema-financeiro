# Copie para .env (ou exporte como variáveis de ambiente reais) e preencha.
# Nunca commitar o .env real — ver .gitignore.

# --- Banco de dados ---
DB_URL=jdbc:postgresql://localhost:5432/sistema_financeiro
DB_USERNAME=sistema_financeiro_app
DB_PASSWORD=troque-esta-senha
DB_POOL_SIZE=4

# --- JWT ---
# Gere com: openssl rand -base64 48
JWT_SECRET=
JWT_ACCESS_EXPIRATION_MINUTES=15
JWT_REFRESH_EXPIRATION_DAYS=30

# --- Cookies ---
# true em produção (HTTPS); false em desenvolvimento local (HTTP)
COOKIE_SECURE=false

# --- CORS ---
CORS_ALLOWED_ORIGIN=http://localhost:5173

# --- Servidor ---
SERVER_PORT=8080

# --- Perfil ativo ---
SPRING_PROFILES_ACTIVE=dev
